# Gateway configuration example (PRD-006).
# Copy to ~/.cursor-agent/gateway.yaml and set secrets in the environment.
#
# CLI override (Wave 4): cursor-agent gateway --config /path/to/gateway.yaml

workspace: /path/to/your/project
tool_profile: messaging

# Optional — model id (omit → default grok-4.5). Pin Composer for cost if preferred:
# model: composer-2.5

# Optional — directory containing USER.md and MEMORY.md (default: ~/.cursor-agent)
# memory_root: /path/to/memory

platforms:
  telegram:
    enabled: true
    bot_token: ${TELEGRAM_BOT_TOKEN}
    allowed_users:
      - 123456789
      - 987654321
  # Optional — IMAP/SMTP email channel (AgentMail, Gmail, Fastmail, …)
  # email:
  #   enabled: true
  #   address: bot@agentmail.to
  #   password: ${EMAIL_PASSWORD}
  #   imap_host: imap.agentmail.to
  #   imap_port: 993
  #   smtp_host: smtp.agentmail.to
  #   smtp_port: 465
  #   poll_interval_seconds: 15
  #   allowed_users:
  #     - you@example.com
