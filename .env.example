# Environment variables for local development. Canonical config prefix is
# CURSOR_AGENT__* per ADR-007; CURSOR_API_KEY is the SDK exception (no prefix).

# Required — user or service-account API key from https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Optional — Telegram bot token from BotFather for gateway polling
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Optional — IMAP/SMTP password (or AgentMail API key) for the email gateway
# EMAIL_PASSWORD=your-email-password-or-api-key

# Optional — default workspace for local agents (ADR-007 nested env)
# CURSOR_AGENT__RUNTIME__LOCAL__CWD=.

# Optional — model id (default: grok-4.5; pin Composer with composer-2.5)
# CURSOR_AGENT__MODEL=grok-4.5
# CURSOR_AGENT__MODEL=composer-2.5

# Optional — tool profile: coding | messaging | full (default: coding)
# full is local-only (gateway refuses it). See docs/setup.md and ADR-029.
# CURSOR_AGENT__TOOL_PROFILE=coding

# Optional — curated MCP allowlist for tool_profile=full (JSON list; default = all)
# CURSOR_AGENT__MCP__FULL__SERVERS=["github","brave-search","playwright"]

# Optional — github MCP transport for tool_profile=full: http (default) | stdio
# http = official remote; stdio = Docker (operator choice for air-gapped hosts)
# CURSOR_AGENT__MCP__FULL__GITHUB_TRANSPORT=http

# Optional — secrets for curated MCP servers under tool_profile=full (env only; never YAML)
# Missing keys omit that server with a one-time warning; REPL does not hard-fail.
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat
# BRAVE_API_KEY=your-brave-api-key
# playwright needs no secret env

# Optional — OAuth access token override for `cursor-agent usage`
# (default: accessToken from ~/.config/cursor/auth.json written by
# `agent login` from the official Cursor Agent CLI — not this package).
# CURSOR_API_KEY is not accepted by the dashboard usage endpoint.
# CURSOR_AGENT_USAGE_TOKEN=

# Optional — SQLite session store (default: ~/.cursor-agent/sessions.db)
# CURSOR_AGENT_SESSIONS_DB=

# Optional — directory containing USER.md and MEMORY.md (default: ~/.cursor-agent)
# CURSOR_AGENT__MEMORY_ROOT=/path/to/memory

# Optional SDK debug logging: debug | info
# CURSOR_SDK_LOG=info
